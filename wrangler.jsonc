/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Required bindings:
 * - AI: Cloudflare Workers AI binding used to route OpenAI Responses requests through AI Gateway
 *
 * Required secrets (wrangler secret put; locally in .dev.vars, see .dev.vars.example):
 * - RESEND_API_KEY: Resend API key used to read inbox emails and send replies
 * - RESEND_WEBHOOK_SECRET: Signing secret (whsec_...) of the Resend webhook endpoint
 *
 * Mail arrives as Resend `inbox.email.received` webhooks on POST /webhooks/resend and replies go
 * out through the Resend Inboxes API; there is no Email Routing handler or send_email binding.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caf-gpt-email",
  "account_id": "7101c0eb0cce7925fd15056c805c97eb",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 60000 // default is 30000 (30 seconds)
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "ai": {
    "binding": "AI"
  },
  // Workers Logs were already on; enable top-level observability + Traces.
  // Invocation logs stay off: the platform invocation record indexes request details (it indexed
  // the full envelope sender/recipient on the old Email Routing path). App logs carry domains,
  // emailRef and opaque Resend ids instead, and Traces still record per-invocation outcome/timing.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "policies"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "UserAgent",
        "class_name": "UserAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserAgent"]
    }
  ]
}
