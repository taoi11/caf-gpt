# Copy to .dev.vars for `wrangler dev` (never commit .dev.vars). Production values are Worker
# secrets: `npx wrangler secret put RESEND_API_KEY` and `npx wrangler secret put RESEND_WEBHOOK_SECRET`.

# Resend API key (https://resend.com/api-keys); needs access to Inboxes and received/sent emails.
RESEND_API_KEY=<API key from https://resend.com/api-keys>

# Signing secret of the Resend webhook endpoint for inbox.email.received (Webhooks > endpoint).
RESEND_WEBHOOK_SECRET=<signing secret from the Resend webhook endpoint>
